// @id=wr_1789725390132061141 @name=Ardour-8.12.0~ds
window-rule {
    match app-id="^Ardour-8.12.0~ds$"
    open-floating true
    open-focused true
}

// @id=wr_1789725607305511375 @name=org.rncbc.qjackctl
window-rule {
    match app-id="^org.rncbc.qjackctl$"
    open-floating true
    default-floating-position x=12 y=12 relative-to="top-right"
}

