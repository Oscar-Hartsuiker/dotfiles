<?xml version="1.0"?>
<labwc_config>

  <core>
    <gap>4</gap>
  </core>
  
  <theme>
    <font place="OnScreenDisplay">
      <name>sans</name>
      <size>16</size>
    </font>
    <font place="ActiveWindow">
      <name>sans</name>
      <size>14</size>
    </font>
    <font place="InactiveWindow">
      <name>sans</name>
      <size>14</size>
    </font>
    <cornerRadius>0</cornerRadius>
  </theme>

  <focus>
    <followMouse>yes</followMouse>
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <windowSwitcher show="yes" preview="yes" outlines="yes" />

<keyboard>
  <!-- Apps -->
  <keybind key="W-Return">
    <action name="Execute" command="ghostty" />
  </keybind>
  <keybind key="W-S-Return">
    <action name="Execute" command="kitty" />
  </keybind>
  <keybind key="W-o">
    <action name="Execute" command="obsidian" />
  </keybind>
  <keybind key="W-w">
    <action name="Execute" command="zapzap" />
  </keybind>
  <keybind key="W-e">
    <action name="Execute" command="nemo" />
  </keybind>
  <keybind key="W-b">
    <action name="Execute" command="firefox" />
  </keybind>
  <keybind key="W-y">
    <action name="Execute" command="ghostty -e yazi" />
  </keybind>

  <!-- Dank launcher -->
  <keybind key="Super_L" onRelease="yes">
    <action name="Execute" command="dms ipc call spotlight toggle" />
  </keybind>

  <!-- Window management -->
  <keybind key="W-x">
    <action name="Close" />
  </keybind>
  <keybind key="A-Tab">
    <action name="NextWindow" />
  </keybind>
  <keybind key="W-f">
    <action name="ToggleMaximize" />
  </keybind>
  <keybind key="W-S-f">
    <action name="ToggleFullscreen" />
  </keybind>
  <keybind key="W-c">
    <action name="Center" />
  </keybind>

  <!-- Snap positioning -->
  <keybind key="W-Left">
    <action name="SnapToEdge" direction="left" />
  </keybind>
  <keybind key="W-Right">
    <action name="SnapToEdge" direction="right" />
  </keybind>
  <keybind key="W-Up">
    <action name="SnapToEdge" direction="up" />
  </keybind>
  <keybind key="W-Down">
    <action name="SnapToEdge" direction="down" />
  </keybind>

  <!-- Workspaces -->
  <keybind key="W-1">
    <action name="GoToDesktop" to="1" />
  </keybind>
  <keybind key="W-2">
    <action name="GoToDesktop" to="2" />
  </keybind>
  <keybind key="W-3">
    <action name="GoToDesktop" to="3" />
  </keybind>
  <keybind key="W-S-1">
    <action name="SendToDesktop" to="1" />
  </keybind>
  <keybind key="W-S-2">
    <action name="SendToDesktop" to="2" />
  </keybind>
  <keybind key="W-S-3">
    <action name="SendToDesktop" to="3" />
  </keybind>

  <!-- Session -->
  <keybind key="W-S-e">
    <action name="Exit" />
  </keybind>
</keyboard>

  <!-- Mouse-driven move/resize — this is the actual point of using labwc for DAW work -->
  <mouse>
    <default />
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
    </context>
    <context name="Titlebar">
      <mousebind button="Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" />
      </mousebind>
    </context>
    <context name="Frame">
      <mousebind button="W-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="W-Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="default">
      <naturalScroll>yes</naturalScroll>
    </device>
  </libinput>
  
  <desktops number="3" />

</labwc_config>
