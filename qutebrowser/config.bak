import os
import sys

config.load_autoconfig(True)
import os

config.load_autoconfig(True)

dark_flag = "/tmp/qutebrowser-gruvbox-dark"
light_flag = "/tmp/qutebrowser-gruvbox-light"

if os.path.exists(dark_flag) or os.path.exists(light_flag):
    if os.path.exists(dark_flag):
        theme = os.path.expanduser("~/.config/qutebrowser/gruvbox/gruvbox-dark.py")
        if os.path.exists(theme):
            config.source(theme)
        c.colors.webpage.preferred_color_scheme = "dark"
        c.colors.webpage.darkmode.enabled = True
        # c.colors.webpage.bg = "black"
    else:  # light flag exists
        theme = os.path.expanduser("~/.config/qutebrowser/gruvbox/gruvbox-light.py")
        if os.path.exists(theme):
            config.source(theme)
        c.colors.webpage.preferred_color_scheme = "light"
        c.colors.webpage.darkmode.enabled = False
        c.colors.webpage.bg = "#FBF1C7"
    # Optional: set a default theme if neither flag exists
    # else:
    # sys.path.insert(0, os.path.expanduser("~/.config/qutebrowser/catppuccin"))
